# =============================================================================
# Fundy MVP — environment variables
# Copy this file to .env and fill in real values.
#
# VITE_-prefixed vars are bundled into the client build (safe to expose).
# All other vars are server-side only — set them in Vercel project settings
# and NEVER expose them to the client.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — client side (safe to expose, RLS enforced)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxx

# -----------------------------------------------------------------------------
# Supabase — server side (Vercel env vars only, NEVER expose to the client)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sbp_xxxxx

# -----------------------------------------------------------------------------
# Frontend flags
# -----------------------------------------------------------------------------
# Set true for client-side mock mode (no backend required).
VITE_LLM_MOCK=true
# Legacy alias for VITE_LLM_MOCK (still accepted for backwards compatibility).
VITE_DIFY_MOCK=true
# Use SSE streaming for chat responses when a real backend is available.
VITE_DIFY_STREAMING=false

# -----------------------------------------------------------------------------
# LLM models — server side (Vercel AI SDK "provider:model" specs)
# The provider prefix selects the SDK provider; openai uses OPENAI_API_KEY.
# -----------------------------------------------------------------------------
LLM_CHAT_MODEL=openai:gpt-4o-mini       # onboarding + deep-dive chat
LLM_EVAL_MODEL=openai:gpt-4o            # evaluation + investment matching
LLM_ANALYSIS_MODEL=openai:gpt-4o-mini   # action-item status analysis

# -----------------------------------------------------------------------------
# OpenAI — server side
# Used for embeddings (text-embedding-3-small) AND as the provider for any
# openai:* model specs above.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Knowledge base selection — server side
# 'internal' uses Supabase pgvector; a partner ID selects an external KB.
# -----------------------------------------------------------------------------
ACTIVE_KNOWLEDGE_BASE=internal

# -----------------------------------------------------------------------------
# Webhook authentication — server side
# Shared secret for external → Vercel callbacks on the /api/knowledge endpoints.
# (Named DIFY_WEBHOOK_SECRET for historical reasons; still in use.)
# -----------------------------------------------------------------------------
DIFY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Demo user credentials
# VITE_* vars are bundled into the client build (intentional — demo is public).
# The non-VITE pair is used server-side by the seed:demo script.
# -----------------------------------------------------------------------------
VITE_DEMO_USER_EMAIL=demo@fundy.nusuai.com
VITE_DEMO_USER_PASSWORD=FundyDemo2026!
DEMO_USER_EMAIL=demo@fundy.nusuai.com
DEMO_USER_PASSWORD=FundyDemo2026!
</content>
