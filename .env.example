# Dify API Configuration
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_ONBOARDING_API_KEY=app-xxxxxxxxxxxxxxxxxxxx
DIFY_DEEPDIVE_API_KEY=app-xxxxxxxxxxxxxxxxxxxx

# Frontend flags (prefixed with VITE_ to be available in client code)
VITE_DIFY_MOCK=true
VITE_DIFY_STREAMING=false

# Supabase (client-side — safe to expose, RLS enforced)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxx

# Supabase (server-side — Vercel env vars only, NEVER expose to client or Dify)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sbp_xxxxx

# Dify evaluation workflow
DIFY_EVALUATION_API_KEY=app-xxxxxxxxxxxxxxxxxxxx

# Dify webhook authentication (shared secret for Dify → Vercel proxy endpoints)
DIFY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# OpenAI (server-side only — for embedding generation)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Knowledge base selection (default: 'internal' for Supabase pgvector)
ACTIVE_KNOWLEDGE_BASE=internal

# Demo user credentials
# VITE_* vars are bundled into the client build (intentional — demo is public)
VITE_DEMO_USER_EMAIL=demo@fundy.nusuai.com
VITE_DEMO_USER_PASSWORD=FundyDemo2026!
# Server-side only (used by seed:demo script)
DEMO_USER_EMAIL=demo@fundy.nusuai.com
DEMO_USER_PASSWORD=FundyDemo2026!
